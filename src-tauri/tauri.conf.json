{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaDock",
  "version": "0.5.0",
  "identifier": "com.rupingliu.quotadock",
  "mainBinaryName": "quotadock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/sync-webview2-loader.mjs",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuotaDock",
        "width": 360,
        "height": 36,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "details",
        "title": "QuotaDock 详情与设置",
        "width": 440,
        "height": 600,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/windows/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMDNBREVEMThEREMxQTcKUldTbndkMFk3YTBEV2hvbkViRW1maWlPUHE0MFZyd09SblNUdFNsZnNRcFhITWlRL2xYazdPUCsK",
      "endpoints": [
        "https://github.com/RupingLiu/QuotaDock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

